{
  "name": "dash-bored",
  "version": "0.4.2",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dash-bored": "sh ./scripts/with-worktree-env.sh bun ./src/cli/index.ts",
    "setup": "sh ./scripts/with-worktree-env.sh electrobun prepare",
    "worktree:setup": "bun ./scripts/worktree-setup.ts",
    "dev": "bun ./scripts/dev.ts run",
    "dev:desktop": "bun ./scripts/dev.ts desktop",
    "dev:start": "bun ./scripts/dev.ts start",
    "dev:restart": "bun ./scripts/dev.ts restart",
    "dev:status": "bun ./scripts/dev.ts status",
    "dev:stop": "bun ./scripts/stop-dev.ts",
    "build:cli": "bun ./scripts/build-cli.ts",
    "styles:dead": "bun ./scripts/find-dead-styles.ts",
    "generate:themes": "bun ./scripts/generate-themes.ts",
    "generate:components": "bun ./scripts/generate-component-reference.ts",
    "generate:component-sdk": "bun ./scripts/generate-component-sdk.ts",
    "ui:fixture": "vite --host 127.0.0.1 --port ${DASH_BORED_UI_PORT:-5488} --strictPort",
    "build:renderer": "sh ./scripts/with-worktree-env.sh sh -c 'electrobun prepare && bun ./scripts/build-core-fixture.ts && vite build'",
    "build:renderer:fast": "sh ./scripts/with-worktree-env.sh sh ./scripts/with-prepared-hutch.sh sh -c 'bun ./scripts/build-core-fixture.ts && vite build'",
    "build": "sh ./scripts/with-worktree-env.sh sh -c 'electrobun prepare && bun ./scripts/build-core-fixture.ts && vite build && bun run build:cli && electrobun build --env=canary'",
    "build:release": "DASH_BORED_RELEASE=1 sh ./scripts/with-worktree-env.sh sh -c 'electrobun prepare && bun ./scripts/build-core-fixture.ts && vite build && bun run build:cli && electrobun build --env=canary && bun ./scripts/repair-macos-release-artifacts.ts'",
    "icon:generate": "sh ./scripts/generate-macos-icon.sh",
    "release:prepare": "bun ./scripts/prepare-macos-release.ts",
    "typecheck": "sh ./scripts/with-worktree-env.sh sh -c 'electrobun prepare && bun ./scripts/build-core-fixture.ts && tsc --noEmit'",
    "typecheck:fast": "sh ./scripts/with-worktree-env.sh sh ./scripts/with-prepared-hutch.sh sh -c 'bun ./scripts/build-core-fixture.ts && tsc --noEmit'",
    "qa:release": "python3 scripts/eval/release-qa/runner.py run",
    "qa:update:native": "bun ./scripts/native-update-acceptance.ts",
    "qa:release:test": "python3 -m unittest discover -s tests/release-qa",
    "qa:fast": "sh ./scripts/with-worktree-env.sh sh ./scripts/with-prepared-hutch.sh sh -c 'bun ./scripts/build-core-fixture.ts && tsc --noEmit && bun run test && vite build && bun run build:cli'",
    "test": "bun ./scripts/test.ts",
    "test:renderer-ui": "bun test tests/renderer/ui-interaction.test.ts",
    "native:probe": "bun test tests/renderer/native-webview-contract.test.ts && bun run native:probe:open",
    "native:probe:open": "bun ./scripts/native-webview-probe.ts",
    "qa": "bun run typecheck && bun run test && bun run build:renderer && bun run build:cli",
    "packages:restore": "bun ./scripts/restore-packages.ts",
    "packages:verify-published": "bun ./scripts/verify-core-package.ts"
  },
  "dependencies": {
    "@xterm/xterm": "^6.0.0",
    "ajv": "^8.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "electrobun": "2.0.1",
    "playwright-core": "^1.55.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  }
}
